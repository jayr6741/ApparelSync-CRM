{
  "name": "garmentos",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "mobile",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @garmentos/frontend",
    "dev:web": "npm run dev --workspace @garmentos/frontend",
    "dev:mobile": "npm run start --workspace garmentos-mobile",
    "dev:api": "npm run dev --workspace @garmentos/backend",
    "build:web": "npm run build --workspace @garmentos/frontend",
    "build:api": "npm run build --workspace @garmentos/backend",
    "typecheck:api": "npm run typecheck --workspace @garmentos/backend"
  }
}
